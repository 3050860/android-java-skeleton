        android:layout_marginBottom="24dp" /> <!-- Увеличили отступ перед следующей группой -->


    <!-- ВТОРЫЕ ДВЕ СТРОКИ: Будут заданы из Java кода -->

    <TextView
        android:id="@+id/text3"
